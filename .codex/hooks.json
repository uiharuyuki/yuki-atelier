{
  "description": "Project-local README.md post-write conversion.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" || exit 0; python3 \"$repo_root/scripts/readme_to_html.py\" >/dev/null 2>&1 || true",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"B:\\yuki\\repository\\2026\\06\\yuki-atelier\\scripts\\readme-post-write.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
